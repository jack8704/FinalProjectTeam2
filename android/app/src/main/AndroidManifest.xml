<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 차량 신호 권한 -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />   <!-- Pleos TTS 사용 권한 -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <!-- 서버 통신 권한 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />            <!-- 기어 (Pleos) -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />          <!-- 차속 (AAOS) -->
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_LIGHTS" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />   <!-- 정밀 위치 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />  <!-- 대략 위치 -->
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />

    <!-- 안내 음성 서비스 (Foreground Service) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 안드로이드 11+ 에서 TTS 엔진을 찾기 위해 필요 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- 차량(AAOS) 전용 앱 선언 -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.PRIVATE_CAR_SAFETY" />

    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CoDriver">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CoDriver"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data android:name="distractionOptimized" android:value="true" />  <!-- 운전 중에도 이 화면 허용 요청 -->
        </activity>

        <!-- 안내 음성 서비스 -->
        <service
            android:name=".GuidanceService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>